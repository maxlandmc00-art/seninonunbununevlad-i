<%- include('partials/header') %>

<div class="fixed inset-0 -z-30 bg-[#050505]"></div>
<div class="fixed top-[-10%] left-[-5%] w-[60%] h-[60%] bg-blue-600/10 blur-[180px] rounded-full -z-20 animate-pulse"></div>
<div class="fixed bottom-[-10%] right-[-5%] w-[50%] h-[50%] bg-indigo-600/5 blur-[180px] rounded-full -z-20"></div>

<main class="container mx-auto px-4 lg:px-12 py-10 min-h-screen relative selection:bg-blue-500/30">
    
    <section class="relative overflow-hidden bg-white/[0.01] backdrop-blur-3xl border border-white/5 rounded-[3.5rem] p-8 md:p-14 mb-12 shadow-2xl group transition-all duration-500 hover:border-white/10">
        <div class="absolute top-0 left-0 w-full h-[1px] bg-gradient-to-r from-transparent via-blue-500/50 to-transparent"></div>
        
        <div class="relative z-10 flex flex-col lg:flex-row items-center justify-between gap-12">
            <div class="flex flex-col md:flex-row items-center gap-10">
                <div class="relative">
                    <div class="absolute -inset-6 bg-blue-600/20 blur-3xl rounded-full opacity-0 group-hover:opacity-100 transition-all duration-700"></div>
                    <div class="relative p-1.5 bg-gradient-to-tr from-blue-600 via-indigo-500 to-purple-600 rounded-[2.8rem] shadow-2xl">
                        <img src="https://cdn.discordapp.com/avatars/<%= user.id %>/<%= user.avatar %>.png" 
                             alt="Avatar"
                             class="w-36 h-36 rounded-[2.6rem] object-cover border-4 border-[#0a0a0b] group-hover:scale-[1.02] transition-transform duration-500">
                    </div>
                    <div class="absolute -bottom-1 -right-1 bg-blue-600 text-white p-2.5 rounded-2xl shadow-xl border-[3px] border-[#0a0a0b] flex items-center justify-center">
                        <i class="fas fa-shield-check text-sm"></i>
                    </div>
                </div>

                <div class="text-center md:text-left space-y-4">
                    <div class="space-y-1">
                        <span class="inline-block px-3 py-1 rounded-lg bg-blue-500/10 border border-blue-500/20 text-blue-400 text-[10px] font-black tracking-widest uppercase mb-2">
                            YÖNETİCİ PANELİ
                        </span>
                        <h1 class="text-5xl md:text-6xl font-black text-white italic uppercase tracking-tighter leading-none">
                            DEVELOPER <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-indigo-500">HUB</span>
                        </h1>
                    </div>
                    <p class="text-gray-400 font-medium text-lg leading-relaxed max-w-md">
                        Hoş geldin şef, <span class="text-white font-bold border-b-2 border-blue-500/30 pb-0.5"><%= user.username %></span>. <br>
                        Sistem parametreleri optimize edildi, emirlerini bekliyor.
                    </p>
                </div>
            </div>

            <div class="flex flex-col sm:flex-row gap-5 w-full lg:w-auto">
                <a href="/addbot" class="group/btn relative flex-1 flex items-center justify-center gap-3 px-10 py-5 bg-blue-600 text-white rounded-[1.8rem] font-black text-xs uppercase tracking-[0.2em] overflow-hidden transition-all hover:scale-105 active:scale-95 shadow-[0_20px_40px_rgba(37,99,235,0.2)]">
                    <span class="relative z-10 flex items-center gap-2">
                        <i class="fas fa-plus-circle transition-transform group-hover/btn:rotate-90"></i> SİSTEME BOT EKLE
                    </span>
                </a>
                <a href="/logout" class="flex items-center justify-center px-8 py-5 bg-white/5 border border-white/10 text-gray-400 rounded-[1.8rem] font-black text-xs uppercase tracking-[0.2em] hover:bg-red-500/10 hover:text-red-500 hover:border-red-500/30 transition-all">
                    GÜVENLİ ÇIKIŞ
                </a>
            </div>
        </div>
    </section>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-16">
        <% 
            const stats = [
                { label: 'Yönetilen Bot', value: bots.length, icon: 'fa-robot', theme: 'from-blue-500/20', iconColor: 'text-blue-500', desc: 'Aktif servislerin.' },
                { label: 'Toplam Etkileşim', value: bots.reduce((acc, bot) => acc + (bot.votes || 0), 0), icon: 'fa-bolt', theme: 'from-orange-500/20', iconColor: 'text-orange-500', desc: 'Kullanıcı geri bildirimi.' },
                { label: 'Erişim Gücü', value: bots.reduce((acc, bot) => acc + (bot.servers || 0), 0), icon: 'fa-microchip', theme: 'from-purple-500/20', iconColor: 'text-purple-500', desc: 'Bağlı sunucu sayısı.' }
            ]
        %>
        <% stats.forEach(stat => { %>
            <div class="group relative bg-[#0d0d0f]/40 border border-white/5 p-8 rounded-[3rem] hover:bg-[#0d0d0f]/60 transition-all duration-500">
                <div class="absolute inset-0 bg-gradient-to-br <%= stat.theme %> to-transparent opacity-0 group-hover:opacity-100 transition-opacity rounded-[3rem]"></div>
                
                <div class="relative z-10 flex flex-col h-full justify-between">
                    <div class="flex items-start justify-between mb-6">
                        <div class="w-14 h-14 bg-white/5 rounded-2xl flex items-center justify-center <%= stat.iconColor %> border border-white/10 group-hover:scale-110 group-hover:rotate-6 transition-all duration-500">
                            <i class="fas <%= stat.icon %> text-2xl"></i>
                        </div>
                        <div class="text-right">
                            <p class="text-[10px] text-gray-500 font-black uppercase tracking-[0.3em]"><%= stat.label %></p>
                            <h2 class="text-4xl text-white font-black italic tracking-tighter"><%= stat.value.toLocaleString() %></h2>
                        </div>
                    </div>
                    <p class="text-[11px] text-gray-500 font-medium italic border-t border-white/5 pt-4"><%= stat.desc %></p>
                </div>
            </div>
        <% }) %>
    </div>

    <div class="flex flex-col md:flex-row md:items-end justify-between gap-8 mb-12 px-2">
        <div class="space-y-2">
            <h3 class="text-3xl font-black text-white italic uppercase tracking-tighter flex items-center gap-4">
                <span class="w-12 h-1.5 bg-blue-600 rounded-full shadow-[0_0_15px_rgba(37,99,235,0.5)]"></span> 
                PROJE    ENVANTERİ
            </h3>
            <p class="text-gray-500 text-sm font-medium pl-16">Terminalinde <%= bots.length %> adet aktif proses bulunuyor.</p>
        </div>
        <div class="flex bg-[#111113] p-1.5 rounded-[1.5rem] border border-white/5 shadow-inner">
            <button class="px-8 py-3 bg-blue-600 text-white rounded-2xl text-[10px] font-black uppercase tracking-[0.2em] transition-all shadow-xl">AKTİF</button>
            <button class="px-8 py-3 text-gray-500 rounded-2xl text-[10px] font-black uppercase tracking-[0.2em] hover:text-white transition-all">ARŞİV</button>
        </div>
    </div>

    <div class="grid grid-cols-1 xl:grid-cols-2 gap-8">
        <% if (bots.length > 0) { %>
            <% bots.forEach(bot => { %>
                <div class="group relative bg-[#0a0a0b]/80 border border-white/5 rounded-[3.5rem] p-10 hover:border-blue-500/30 transition-all duration-500">
                    <div class="absolute inset-0 bg-gradient-to-tr from-blue-600/[0.03] via-transparent to-transparent rounded-[3.5rem]"></div>
                    
                    <div class="relative flex flex-col md:flex-row items-center gap-10">
                        <div class="relative shrink-0">
                            <div class="absolute -inset-3 bg-gradient-to-tr from-blue-600 to-indigo-600 rounded-[2.8rem] opacity-0 group-hover:opacity-40 blur-xl transition-all duration-700"></div>
                            <img src="<%= bot.avatar %>" class="relative w-32 h-32 rounded-[2.5rem] object-cover border-4 border-[#111113] shadow-2xl">
                            <div class="absolute -bottom-1 -right-1 bg-green-500 w-7 h-7 rounded-full border-[5px] border-[#0a0a0b] shadow-lg shadow-green-500/20"></div>
                        </div>

                        <div class="flex-1 text-center md:text-left space-y-5">
                            <div>
                                <h4 class="text-3xl font-black text-white uppercase italic tracking-tighter group-hover:text-blue-400 transition-colors duration-300">
                                    <%= bot.name %>
                                </h4>
                                <p class="text-gray-500 text-xs font-bold tracking-widest mt-1 opacity-60 uppercase"><%= bot.id %></p>
                            </div>
                            
                            <div class="flex flex-wrap justify-center md:justify-start gap-4">
                                <div class="bg-white/[0.03] border border-white/5 px-5 py-3 rounded-2xl transition-colors group-hover:bg-white/[0.05]">
                                    <p class="text-[9px] text-gray-500 font-black uppercase tracking-widest mb-1">OY GÜCÜ</p>
                                    <div class="flex items-center gap-2">
                                        <i class="fas fa-heart text-red-500 text-xs animate-pulse"></i>
                                        <span class="text-white font-black text-base tabular-nums"><%= bot.votes %></span>
                                    </div>
                                </div>
                                <div class="bg-white/[0.03] border border-white/5 px-5 py-3 rounded-2xl transition-colors group-hover:bg-white/[0.05]">
                                    <p class="text-[9px] text-gray-500 font-black uppercase tracking-widest mb-1">SUNUCULAR</p>
                                    <div class="flex items-center gap-2 text-blue-500">
                                        <i class="fas fa-server text-xs"></i>
                                        <span class="text-white font-black text-base tabular-nums"><%= bot.servers %></span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="flex md:flex-col gap-3 w-full md:w-36 relative z-20">
                            <a href="/bot/<%= bot.id %>" class="flex-1 py-4 bg-white/5 text-white border border-white/10 rounded-2xl font-black text-[10px] uppercase tracking-widest hover:bg-white hover:text-[#050505] transition-all text-center">
                                İNCELE
                            </a>
                            <a href="/bot/<%= bot.id %>/edit" class="flex-1 py-4 bg-blue-600 text-white rounded-2xl font-black text-[10px] uppercase tracking-widest hover:bg-blue-500 hover:shadow-lg hover:shadow-blue-500/20 transition-all text-center">
                                DÜZENLE
                            </a>
                        </div>
                    </div>

                    <div class="mt-10 pt-6 border-t border-white/5 flex items-center justify-between opacity-60 group-hover:opacity-100 transition-opacity">
                        <div class="flex items-center gap-6 text-[10px] font-black text-gray-500 uppercase tracking-widest">
                            <span class="flex items-center gap-2"><i class="fas fa-code-merge text-blue-500"></i> v14.x stable</span>
                            <span class="flex items-center gap-2"><i class="fas fa-shield-check text-green-500"></i> Güvenli</span>
                        </div>
                        <div class="flex items-center gap-2 text-gray-500 italic text-[10px]">
                            <span>ID: <%= bot.id.toString().slice(0,5) %>...</span>
                        </div>
                    </div>
                </div>
            <% }) %>
        <% } else { %>
            <div class="col-span-full py-40 bg-white/[0.01] border-2 border-dashed border-white/5 rounded-[4rem] text-center group/empty transition-all hover:border-blue-500/20">
                <div class="relative inline-block mb-10">
                    <div class="absolute inset-0 bg-blue-600/20 blur-3xl rounded-full group-hover/empty:scale-150 transition-transform duration-700"></div>
                    <div class="relative w-28 h-28 bg-[#0a0a0b] border border-white/10 rounded-full flex items-center justify-center shadow-2xl">
                        <i class="fas fa-rocket-launch text-gray-700 text-4xl group-hover/empty:text-blue-500 group-hover/empty:-translate-y-2 transition-all duration-500"></i>
                    </div>
                </div>
                <h5 class="text-3xl font-black text-white italic uppercase tracking-tighter mb-4">Ufukta Hiç Proje Görünmüyor!</h5>
                <p class="text-gray-500 max-w-sm mx-auto mb-10 font-medium leading-relaxed">Sistemde kayıtlı bir botun bulunmuyor. Hemen ilk projenle ekosisteme giriş yap.</p>
                <a href="/addbot" class="px-14 py-6 bg-blue-600 text-white rounded-3xl font-black text-xs uppercase tracking-[0.4em] hover:bg-blue-500 hover:scale-105 transition-all inline-block shadow-2xl">
                    OPERASYONU BAŞLAT
                </a>
            </div>
        <% } %>
    </div>
</main>

<style>
    /* Performanslı Animasyonlar */
    @keyframes slideUp {
        from { opacity: 0; transform: translateY(30px); }
        to { opacity: 1; transform: translateY(0); }
    }
    
    main {
        animation: slideUp 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    }

    /* Özel Scrollbar */
    ::-webkit-scrollbar { width: 10px; }
    ::-webkit-scrollbar-track { background: #050505; }
    ::-webkit-scrollbar-thumb { 
        background: #1a1a1c; 
        border-radius: 20px; 
        border: 2px solid #050505;
    }
    ::-webkit-scrollbar-thumb:hover { background: #2563eb; }

    /* Glassmorphism Fix for Safari */
    .backdrop-blur-3xl {
        -webkit-backdrop-filter: blur(64px);
    }
</style>

<%- include('partials/footer') %>