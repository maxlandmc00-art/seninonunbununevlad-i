<!DOCTYPE html>
<html lang="tr" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <title>Elecus Botlist | Geleceği Keşfet</title>
    <style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; background-color: #050505; color: white; }
        
        .glow-bg {
            position: fixed; top: 0; left: 50%; transform: translateX(-50%);
            width: 100%; height: 100%;
            background: radial-gradient(circle at 50% -20%, #1e40af33 0%, transparent 50%);
            pointer-events: none; z-index: -1;
        }

        .glass {
            background: rgba(10, 10, 11, 0.8);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
        }

        .nav-link::after {
            content: ''; display: block; width: 0; height: 2px;
            background: #3b82f6; transition: width .3s; margin-top: 4px;
        }
        .nav-link:hover::after { width: 100%; }

        /* Floating Animasyonu */
        @keyframes float {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-8px); }
        }
        .floating { animation: float 3s ease-in-out infinite; }
    </style>
</head>
<body class="overflow-x-hidden">

<div class="glow-bg"></div>
<header class="glass border-b border-white/5 sticky top-0 z-[100]">
    <div class="container mx-auto px-4 lg:px-12 py-3">
        <div class="flex items-center justify-between">
            
            <div class="flex items-center gap-10">
                <a href="/" class="flex items-center gap-3 group">
                    <div class="relative">
                        <div class="absolute inset-0 bg-blue-600 blur-md opacity-20 group-hover:opacity-50 transition-opacity"></div>
                        <img src="https://r.resimlink.com/NZHshMqBtdcf.png" class="relative w-11 h-11 object-contain floating" alt="Logo">
                    </div>
                    <div class="flex flex-col">
                        <div class="flex items-center gap-2">
                            <span class="text-2xl font-black tracking-tighter leading-none">
                                ELECUS<span class="text-blue-500"> DISCORD</span>
                            </span>
                            <span class="px-1.5 py-0.5 rounded-md bg-blue-500/10 border border-blue-500/20 text-blue-500 text-[9px] font-black uppercase tracking-widest shadow-[0_0_10px_rgba(59,130,246,0.2)]">
                                BETA
                            </span>
                        </div>
                        <span class="text-[10px] text-gray-500 font-bold tracking-[0.4em] uppercase">‎ ‎ ‎ ‎ ‎ ‎ ‎ ‎ BOT / VOTE</span>
                    </div>
                </a>

                <nav class="hidden lg:flex items-center gap-4">
                    <a href="/" class="nav-link text-gray-400 hover:text-white font-semibold text-xs uppercase tracking-widest transition mr-4">Keşfet</a>
                    
                    <a href="/addbot" class="group relative flex items-center gap-2 px-5 py-2 bg-blue-600/10 hover:bg-blue-600/20 text-blue-400 hover:text-white rounded-xl text-[11px] font-extrabold uppercase tracking-widest transition-all duration-300 border border-blue-500/30 overflow-hidden">
                        <span class="absolute inset-0 w-full h-full bg-gradient-to-r from-transparent via-white/5 to-transparent -translate-x-full group-hover:animate-[shimmer_2s_infinite]"></span>
                        <i class="fas fa-plus transition-transform duration-500 group-hover:rotate-180"></i>
                        <span class="relative">Bot Ekle</span>
                    </a>

                    <a href="https://discord.gg/kD2ssEjhZd" target="_blank" class="group relative flex items-center gap-2 px-5 py-2 bg-[#5865F2]/10 hover:bg-[#5865F2] text-[#5865F2] hover:text-white rounded-xl text-[11px] font-extrabold uppercase tracking-widest transition-all duration-300 border border-[#5865F2]/30">
                        <i class="fab fa-discord text-[14px] group-hover:animate-bounce"></i>
                        <span class="relative">Discord</span>
                    </a>
                </nav>
            </div>

            <div class="flex items-center gap-3 md:gap-6">
                <button class="hidden sm:flex w-10 h-10 items-center justify-center rounded-xl hover:bg-white/5 transition border border-transparent hover:border-white/10 text-gray-400 hover:text-white">
                    <i class="fas fa-search"></i>
                </button>

                <% if (typeof user !== 'undefined' && user) { %>
                    <div class="relative group">
                        <div class="flex items-center gap-3 pl-2 pr-1 py-1 rounded-2xl bg-white/[0.03] border border-white/5 hover:border-blue-500/30 transition-all cursor-pointer">
                            <div class="relative">
                                <img src="https://cdn.discordapp.com/avatars/<%= user.id %>/<%= user.avatar %>.png" 
                                     class="w-10 h-10 rounded-xl object-cover ring-2 ring-blue-600/20" alt="User">
                                <div class="absolute -bottom-1 -right-1 w-3.5 h-3.5 bg-green-500 border-[3px] border-[#0a0a0b] rounded-full"></div>
                            </div>
                            <div class="hidden md:flex flex-col mr-2">
                                <span class="text-white font-bold text-[12px]"><%= user.username %></span>
                                <span class="text-blue-500 text-[9px] font-extrabold uppercase tracking-tighter">Kullanıcı</span>
                            </div>
                            <div class="w-8 h-8 flex items-center justify-center rounded-lg bg-white/5 text-gray-400 group-hover:text-white transition">
                                <i class="fas fa-chevron-down text-[10px]"></i>
                            </div>
                        </div>

                        <div class="absolute right-0 mt-3 w-64 opacity-0 invisible group-hover:opacity-100 group-hover:visible translate-y-2 group-hover:translate-y-0 transition-all duration-300 z-[110]">
                            <div class="bg-[#0f0f11] border border-white/10 rounded-2xl p-2 shadow-2xl backdrop-blur-2xl">
                                <div class="px-4 py-3 border-b border-white/5 mb-2">
                                    <p class="text-[10px] text-gray-500 font-bold uppercase tracking-widest">Hesap Ayarları</p>
                                </div>
                                <a href="/profile" class="flex items-center gap-3 px-4 py-3 rounded-xl hover:bg-blue-600 text-gray-300 hover:text-white transition group/item">
                                    <div class="w-8 h-8 rounded-lg bg-white/5 flex items-center justify-center group-hover/item:bg-white/20">
                                        <i class="fas fa-user text-sm"></i>
                                    </div>
                                    <span class="text-sm font-medium">Profilimi Görüntüle</span>
                                </a>
                                <a href="/dashboard" class="flex items-center gap-3 px-4 py-3 rounded-xl hover:bg-blue-600 text-gray-300 hover:text-white transition group/item">
                                    <div class="w-8 h-8 rounded-lg bg-white/5 flex items-center justify-center group-hover/item:bg-white/20">
                                        <i class="fas fa-columns text-sm"></i>
                                    </div>
                                    <span class="text-sm font-medium">Yönetim Paneli</span>
                                </a>
                                <div class="h-[1px] bg-white/5 my-2 mx-4"></div>
                                <a href="/logout" class="flex items-center gap-3 px-4 py-3 rounded-xl hover:bg-red-500/10 text-red-500 transition group/item">
                                    <div class="w-8 h-8 rounded-lg bg-red-500/10 flex items-center justify-center">
                                        <i class="fas fa-sign-out-alt text-sm"></i>
                                    </div>
                                    <span class="text-sm font-bold">Güvenli Çıkış</span>
                                </a>
                            </div>
                        </div>
                    </div>
                <% } else { %>
                    <a href="/auth/discord" class="group relative px-6 py-2.5 bg-white text-black rounded-xl font-bold text-[11px] uppercase tracking-tighter transition-all hover:bg-gray-100 active:scale-95">
                        <span>Giriş Yap</span>
                        <i class="fab fa-discord ml-2 text-lg align-middle"></i>
                    </a>
                <% } %>

                <button class="lg:hidden w-11 h-11 flex items-center justify-center rounded-2xl bg-white/5 border border-white/10 active:scale-90 transition">
                    <i class="fas fa-bars-staggered text-xl text-blue-500"></i>
                </button>
            </div>
        </div>
    </div>
</header>

<style>
@keyframes shimmer {
    100% { transform: translateX(100%); }
}
</style>