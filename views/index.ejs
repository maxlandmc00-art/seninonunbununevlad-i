<%- include('partials/header') %>
<head>
<link rel="icon" type="image/png" href="/img/logo.png">
</head>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<style>
    .bot-card-glow:hover { box-shadow: 0 0 30px -10px rgba(37, 99, 235, 0.4); }
    .hero-animate { animation: float 6s ease-in-out infinite; }
    @keyframes float { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-10px); } }
    
    /* Reklam için özel parlama efekti */
    .reklam-glow {
        position: relative;
        overflow: hidden;
    }
    .reklam-glow::after {
        content: "";
        position: absolute;
        top: -50%;
        left: -50%;
        width: 200%;
        height: 200%;
        background: conic-gradient(from 0deg, transparent, rgba(37, 99, 235, 0.3), transparent 30%);
        animation: rotate 4s linear infinite;
        z-index: 0;
    }
    @keyframes rotate { 100% { transform: rotate(360deg); } }
</style>

<main class="container mx-auto px-4 lg:px-12 py-10 relative">

<div class="mb-10 group relative max-w-4xl mx-auto">
    <div class="absolute -inset-0.5 bg-gradient-to-r from-blue-600 to-indigo-600 rounded-[2.5rem] blur opacity-20 group-hover:opacity-50 transition duration-1000"></div>
    
    <a href="https://discord.com/channels/1456643636199428129/1457298904059089059" target="_blank" class="relative block overflow-hidden rounded-[2.5rem] border border-white/10 shadow-2xl transition-transform duration-500 hover:scale-[1.01] active:scale-[0.99]">
        
        <img 
            src="https://r.resimlink.com/G_f6c.png" 
            alt="Sponsorlu Reklam" 
            class="w-full h-full object-cover min-h-[120px]"
        />

        <div class="absolute top-4 right-6">
            <span class="bg-black/40 backdrop-blur-md text-white/70 text-[10px] px-3 py-1 rounded-full border border-white/10 tracking-widest uppercase font-bold">
                Sponsorlu
            </span>
        </div>

        <div class="absolute inset-0 bg-white/5 opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
    </a>
</div>

    <div class="bg-[#0a0a0b]/60 backdrop-blur-xl p-4 md:p-6 rounded-[2.5rem] mb-12 flex flex-col lg:flex-row justify-between items-center gap-6 border border-white/5 shadow-2xl">
        <form action="/" method="GET" class="relative w-full lg:w-1/3 group">
            <i class="fas fa-search absolute left-6 top-1/2 -translate-y-1/2 text-blue-500/50 group-focus-within:text-blue-500 transition-colors"></i>
            <input type="text" name="search" value="<%= search %>" placeholder="Harika bir bot keşfet..." 
                   class="w-full bg-white/[0.03] border border-white/5 py-4 pl-14 pr-6 rounded-2xl focus:border-blue-500 focus:bg-white/[0.05] outline-none transition text-sm text-white">
        </form>
        
        <div class="flex flex-wrap gap-2 justify-center">
            <% ['Moderasyon', 'Eğlence', 'Ekonomi', 'Müzik', 'Sistem'].forEach(function(cat) { %>
                <a href="/?category=<%= cat %>" 
                   class="px-6 py-3 rounded-xl border border-white/5 text-[10px] font-black transition-all uppercase tracking-[0.15em]
                   <%= currentCategory === cat ? 'bg-blue-600 text-white shadow-lg shadow-blue-600/30 border-blue-500' : 'bg-white/5 text-gray-500 hover:text-white hover:bg-white/10' %>">
                     <%= cat %>
                </a>
            <% }); %>
        </div>
    </div>

    <% if (firstBot && !currentCategory && !search && sort !== 'top') { %>
    <section class="relative overflow-hidden rounded-[4rem] p-[2px] bg-gradient-to-br from-blue-600/40 via-blue-500/10 to-transparent mb-24 group">
        <div class="bg-[#080809] rounded-[3.9rem] p-8 md:p-16 flex flex-col lg:flex-row items-center gap-12 relative overflow-hidden">
            <div class="absolute -top-24 -left-24 w-96 h-96 bg-blue-600/10 rounded-full blur-[120px]"></div>
            
            <div class="relative z-10 shrink-0 cursor-pointer hero-animate" onclick="window.location.href='/bot/<%= firstBot.id %>'">
                <div class="w-48 h-48 md:w-64 md:h-64 rounded-[3.5rem] overflow-hidden border-8 border-[#0a0a0b] shadow-[0_20px_50px_rgba(0,0,0,0.5)] transform group-hover:scale-[1.02] transition-all duration-500">
                    <img src="<%= firstBot.avatar %>" class="w-full h-full object-cover">
                </div>
                <div class="absolute -top-4 -right-4 bg-gradient-to-tr from-yellow-600 to-yellow-400 text-white w-16 h-16 rounded-2xl flex items-center justify-center shadow-2xl rotate-12 border-4 border-[#080809]">
                    <i class="fas fa-crown text-2xl animate-pulse"></i>
                </div>
            </div>

            <div class="flex-1 text-center lg:text-left z-10">
                <div class="inline-flex items-center gap-2 bg-blue-500/10 border border-blue-500/20 px-4 py-2 rounded-full mb-6">
                    <span class="w-2 h-2 bg-blue-500 rounded-full animate-ping"></span>
                    <span class="text-blue-400 text-[10px] font-black uppercase tracking-[0.2em]"> Vote 1.Cisi</span>
                </div>
                <h2 class="text-5xl md:text-8xl font-black text-white mb-6 tracking-tighter cursor-pointer hover:text-blue-500 transition-colors duration-300" onclick="window.location.href='/bot/<%= firstBot.id %>'">
                    <%= firstBot.name %>
                </h2>
                <p class="text-gray-400 text-lg md:text-xl leading-relaxed max-w-2xl mb-10 font-medium italic opacity-80">
                    "<%= firstBot.description.substring(0, 160) %>..."
                </p>
                <div class="flex flex-wrap justify-center lg:justify-start gap-5">
                    <a href="/bot/<%= firstBot.id %>" class="bg-blue-600 text-white px-12 py-5 rounded-2xl font-black hover:bg-blue-500 transition-all shadow-xl shadow-blue-600/40 uppercase text-xs tracking-widest active:scale-95">İncele</a>
                    <button onclick="vote('<%= firstBot.id %>')" class="bg-white/5 border border-white/10 text-white px-12 py-5 rounded-2xl font-black hover:bg-white/10 transition-all uppercase text-xs tracking-widest flex items-center gap-3 group/btn active:scale-95">
                        <i class="fas fa-arrow-up text-blue-500 group-hover/btn:-translate-y-1 transition-transform"></i> 
                        <span><span id="v-main-<%= firstBot.id %>"><%= firstBot.votes %></span> OY</span>
                    </button>
                </div>
            </div>
        </div>
    </section>
    <% } %>

    <div class="flex flex-col md:flex-row items-center justify-between mb-12 gap-6">
        <div class="flex items-center gap-4">
            <div class="w-12 h-12 bg-blue-600/10 rounded-2xl flex items-center justify-center border border-blue-500/20">
                <i class="fas <%= sort === 'top' ? 'fa-trophy text-yellow-500' : 'fa-bolt text-blue-500' %> text-xl"></i>
            </div>
            <h3 class="text-3xl font-black uppercase tracking-tighter text-white">
                <%= sort === 'top' ? 'Liderlik Tablosu' : 'Botları Keşfet' %>
            </h3>
        </div>
        
        <div class="flex gap-2 bg-white/[0.03] p-1.5 rounded-2xl border border-white/5">
            <a href="/?sort=new" class="px-6 py-2.5 rounded-xl text-[10px] font-black uppercase tracking-widest transition-all <%= sort !== 'top' ? 'bg-blue-600 text-white shadow-lg' : 'text-gray-500 hover:text-gray-300' %>">Yeni</a>
            <a href="/?sort=top" class="px-6 py-2.5 rounded-xl text-[10px] font-black uppercase tracking-widest transition-all <%= sort === 'top' ? 'bg-blue-600 text-white shadow-lg' : 'text-gray-500 hover:text-gray-300' %>">Popüler</a>
        </div>
    </div>

    <div class="<%= sort === 'top' ? 'flex flex-col gap-6' : 'grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-8' %> mb-24">
        <% bots.forEach(function(bot, index) { %>
            <% if(sort === 'top') { %>
                <% 
                    let frame = "border-white/5 bg-[#0a0a0b]/60 hover:bg-[#0c0c0e]";
                    let rankIcon = "text-gray-600";
                    if(index === 0) { frame = "border-yellow-500/30 bg-yellow-500/[0.02] shadow-[0_0_40px_-15px_rgba(234,179,8,0.2)]"; rankIcon = "text-yellow-500"; }
                    if(index === 1) { frame = "border-slate-400/30 bg-slate-400/[0.02]"; rankIcon = "text-slate-400"; }
                    if(index === 2) { frame = "border-orange-600/30 bg-orange-600/[0.02]"; rankIcon = "text-orange-600"; }
                %>
                <div onclick="window.location.href='/bot/<%= bot.id %>'" class="group relative flex flex-col md:flex-row items-center gap-6 p-5 md:pr-10 rounded-[2.5rem] border backdrop-blur-sm transition-all duration-300 cursor-pointer <%= frame %>">
                    <div class="absolute -left-3 top-1/2 -translate-y-1/2 w-10 h-10 bg-[#0a0a0b] border border-white/10 rounded-xl flex items-center justify-center font-black text-sm italic z-20 <%= rankIcon %> shadow-xl">
                        #<%= index + 1 %>
                    </div>
                    <div class="relative w-full md:w-56 h-32 shrink-0 rounded-3xl overflow-hidden border border-white/5 bg-black group-hover:border-blue-500/30 transition-colors">
                        <% if(bot.banner) { %>
                            <img src="<%= bot.banner %>" class="w-full h-full object-cover opacity-40 group-hover:scale-110 transition-transform duration-700">
                        <% } else { %>
                            <div class="w-full h-full bg-gradient-to-br from-blue-900/20 to-black"></div>
                        <% } %>
                        <div class="absolute inset-0 flex items-center justify-center">
                            <img src="<%= bot.avatar %>" class="w-16 h-16 rounded-2xl border-2 border-white/10 shadow-2xl group-hover:scale-110 transition-transform">
                        </div>
                    </div>
                    <div class="flex-1 text-center md:text-left">
                        <h4 class="font-black text-2xl text-white group-hover:text-blue-400 transition mb-1 uppercase italic tracking-tight"><%= bot.name %></h4>
                        <p class="text-gray-500 text-sm line-clamp-1 italic font-medium"><%= bot.description %></p>
                    </div>
                    <div class="flex items-center gap-8 shrink-0 border-t md:border-t-0 md:border-l border-white/5 pt-4 md:pt-0 md:pl-8">
                        <div class="text-center">
                            <span class="text-[9px] text-gray-600 font-black uppercase block tracking-widest mb-1">Oy Skoru</span>
                            <span class="text-3xl font-black text-white tracking-tighter" id="v-<%= bot.id %>"><%= bot.votes %></span>
                        </div>
                        <button onclick="event.stopPropagation(); vote('<%= bot.id %>')" class="bg-blue-600 hover:bg-blue-500 text-white px-8 py-4 rounded-2xl font-black text-[10px] uppercase tracking-widest transition shadow-lg shadow-blue-600/20 active:scale-95">OY VER</button>
                    </div>
                </div>
            <% } else { %>
                <div onclick="window.location.href='/bot/<%= bot.id %>'" class="group bg-[#0a0a0b]/60 backdrop-blur-sm border border-white/5 rounded-[2.5rem] hover:border-blue-600/50 transition-all duration-500 cursor-pointer relative overflow-hidden flex flex-col bot-card-glow">
                    <div class="h-32 w-full relative overflow-hidden">
                        <% if(bot.banner) { %>
                            <img src="<%= bot.banner %>" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700">
                        <% } else { %>
                            <div class="w-full h-full bg-gradient-to-br from-blue-900/40 to-[#050505]"></div>
                        <% } %>
                        <div class="absolute inset-0 bg-gradient-to-t from-[#0a0a0b] to-transparent"></div>
                        <div class="absolute top-4 left-4 bg-black/60 backdrop-blur-md px-3 py-1 rounded-lg text-[9px] font-black text-blue-400 border border-white/5 uppercase">Yeni</div>
                    </div>
                    <div class="p-6 pt-0 -mt-10 relative z-10 flex-1 flex flex-col">
                        <div class="relative inline-block mb-4">
                            <img src="<%= bot.avatar %>" class="w-20 h-20 rounded-3xl border-[6px] border-[#0a0a0b] shadow-2xl group-hover:rotate-3 transition-transform">
                            <div class="absolute bottom-1 right-1 w-4 h-4 bg-green-500 border-4 border-[#0a0a0b] rounded-full"></div>
                        </div>
                        <h4 class="font-black text-xl text-white group-hover:text-blue-400 transition truncate uppercase italic tracking-tight mb-1"><%= bot.name %></h4>
                        <p class="text-gray-500 text-[13px] mb-6 line-clamp-2 italic font-medium leading-snug h-10"><%= bot.description %></p>
                        <div class="mt-auto flex items-center justify-between border-t border-white/5 pt-5">
                            <div class="flex flex-col">
                                <span class="text-[8px] text-gray-600 font-bold uppercase tracking-widest">Toplam Oy</span>
                                <span class="text-blue-500 font-black text-base tracking-tighter" id="v-<%= bot.id %>"><%= bot.votes %></span>
                            </div>
                            <button onclick="event.stopPropagation(); vote('<%= bot.id %>')" class="bg-white/5 hover:bg-blue-600 text-white px-5 py-2.5 rounded-xl font-black text-[9px] uppercase tracking-widest transition-all shadow-lg active:scale-95 border border-white/5 hover:border-blue-500">OY VER</button>
                        </div>
                    </div>
                </div>
            <% } %>
        <% }); %>
    </div>
</main>

<script>
async function vote(id) {
    try {
        const res = await fetch('/vote/' + id, { method: 'POST' });
        const data = await res.json();
        if(data.status === "success") {
            const counters = [document.getElementById('v-' + id), document.getElementById('v-main-' + id)];
            counters.forEach(c => { 
                if(c) {
                    c.classList.add('text-green-500', 'scale-110');
                    c.innerText = data.votes;
                    setTimeout(() => c.classList.remove('text-green-500', 'scale-110'), 500);
                }
            });
            Swal.fire({
                toast: true, position: 'top-end', icon: 'success', title: 'Oyun kaydedildi!', showConfirmButton: false, timer: 2000, background: '#0a0a0b', color: '#fff'
            });
        } else {
            Swal.fire({ icon: 'warning', title: 'Dikkat', text: data.message, background: '#0a0a0b', color: '#fff', confirmButtonColor: '#2563eb' });
        }
    } catch(e) {
        Swal.fire({ 
            title: 'Kimliğini Doğrula', text: 'Oy vermek için Discord ile giriş yapmalısın.', icon: 'info', showCancelButton: true, confirmButtonText: 'Giriş Yap', cancelButtonText: 'Vazgeç', background: '#0a0a0b', color: '#fff', confirmButtonColor: '#2563eb'
        }).then(r => { if(r.isConfirmed) window.location.href='/auth/discord'; });
    }
}
</script>

<%- include('partials/footer') %>