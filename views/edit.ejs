<%- include('partials/header') %>

<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;800&display=swap" rel="stylesheet">
<style>
    body { font-family: 'Outfit', sans-serif; background-color: #050505; }
    
    .neon-border {
        position: relative;
        border-radius: 2rem;
        background: #0a0a0b;
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    }
    
    .neon-border::before {
        content: ""; position: absolute; inset: -1px; border-radius: 2rem;
        padding: 1px; background: linear-gradient(45deg, transparent, rgba(37, 99, 235, 0.3), transparent);
        -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
        -webkit-mask-composite: xor; mask-composite: exclude; pointer-events: none;
    }

    .neon-border:focus-within {
        border-color: #3b82f6;
        box-shadow: 0 0 20px rgba(37, 99, 235, 0.1);
        transform: translateY(-2px);
    }

    .animate-float { animation: float 6s ease-in-out infinite; }
    @keyframes float { 
        0%, 100% { transform: translateY(0); } 
        50% { transform: translateY(-10px); } 
    }

    /* Custom Checkbox Design */
    .tag-chip { transition: all 0.3s ease; }
    .tag-input:checked + .tag-chip {
        background: #3b82f6 !important;
        color: white !important;
        border-color: #3b82f6 !important;
        box-shadow: 0 4px 15px rgba(37, 99, 235, 0.3);
    }
</style>

<main class="container mx-auto px-4 py-16">
    <div class="max-w-6xl mx-auto">
        
        <div class="relative mb-16 rounded-[3rem] overflow-hidden bg-[#0a0a0b] border border-white/5 shadow-2xl">
            <div class="h-48 w-full bg-gradient-to-r from-blue-900/20 to-purple-900/20 relative">
                <% if(bot.banner) { %>
                    <img src="<%= bot.banner %>" class="w-full h-full object-cover opacity-30 blur-sm" alt="">
                <% } %>
                <div class="absolute inset-0 bg-gradient-to-t from-[#0a0a0b] to-transparent"></div>
            </div>
            
            <div class="px-10 pb-10 -mt-16 flex flex-col md:flex-row items-end gap-6 relative">
                <div class="relative group">
                    <img src="<%= bot.avatar %>" class="w-32 h-32 rounded-[2.5rem] border-8 border-[#0a0a0b] shadow-2xl transition-transform group-hover:scale-105 duration-500 animate-float" alt="">
                    <div class="absolute inset-0 rounded-[2.5rem] bg-blue-600/20 opacity-0 group-hover:opacity-100 transition-opacity"></div>
                </div>
                <div class="flex-1">
                    <div class="flex items-center gap-3 mb-1">
                        <h1 class="text-4xl font-black text-white tracking-tight"><%= bot.name %></h1>
                        <span class="bg-blue-600/10 text-blue-500 text-[10px] px-3 py-1 rounded-full font-black border border-blue-500/20 uppercase tracking-tighter">Verified Bot</span>
                    </div>
                    <p class="text-gray-500 font-medium tracking-wide">Developer Dashboard & Management Control</p>
                </div>
                <div class="flex gap-3 mb-2">
                    <div class="text-center px-6 py-3 bg-white/5 rounded-2xl border border-white/5">
                        <div class="text-xl font-black text-white"><%= bot.votes %></div>
                        <div class="text-[9px] text-gray-500 uppercase font-black tracking-widest">Votes</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
            
            <div class="lg:col-span-2 order-2 lg:order-1">
                <form action="/bot/<%= bot.id %>/edit" method="POST" class="space-y-10">
                    
                    <div class="neon-border p-10 space-y-8">
                        <h3 class="text-blue-500 text-xs font-black tracking-[0.4em] uppercase mb-4 flex items-center gap-4">
                            <i class="fas fa-cog"></i> Teknik Yapılandırma
                        </h3>
                        
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                            <div class="space-y-3">
                                <label class="text-gray-400 text-[11px] font-black uppercase tracking-widest ml-1">Komut Öneki (Prefix)</label>
                                <input type="text" name="prefix" value="<%= bot.prefix %>" placeholder="!" required
                                    class="w-full bg-white/5 border border-white/10 p-5 rounded-2xl text-white font-bold outline-none focus:border-blue-500 transition-all shadow-inner">
                            </div>
                            <div class="space-y-3">
                                <label class="text-gray-400 text-[11px] font-black uppercase tracking-widest ml-1">Sunucu Sayısı</label>
                                <input type="number" name="servers" value="<%= bot.servers %>" 
                                    class="w-full bg-white/5 border border-white/10 p-5 rounded-2xl text-white font-bold outline-none focus:border-blue-500 transition-all shadow-inner">
                            </div>
                        </div>

                        <div class="space-y-3">
                            <div class="flex justify-between">
                                <label class="text-gray-400 text-[11px] font-black uppercase tracking-widest ml-1">Bot Tanıtımı</label>
                                <span id="counter" class="text-[10px] text-blue-500 font-black">0/150</span>
                            </div>
                            <textarea name="shortDesc" id="desc" rows="4" maxlength="150" required
                                class="w-full bg-white/5 border border-white/10 p-5 rounded-2xl text-white outline-none focus:border-blue-500 transition-all resize-none shadow-inner leading-relaxed"><%= bot.description %></textarea>
                        </div>
                    </div>

                    <div class="neon-border p-10">
                        <h3 class="text-blue-500 text-xs font-black tracking-[0.4em] uppercase mb-8 flex items-center gap-4">
                            <i class="fas fa-tags"></i> Kategorizasyon
                        </h3>
                        <div class="flex flex-wrap gap-3">
                            <% ['Moderasyon', 'Müzik', 'Ekonomi', 'Oyun', 'Eğlence', 'Anime', 'Genel'].forEach(cat => { %>
                                <label class="cursor-pointer">
                                    <input type="checkbox" name="tags" value="<%= cat %>" class="hidden tag-input" 
                                        <%= (Array.isArray(bot.tags) ? bot.tags.includes(cat) : bot.tags === cat) ? 'checked' : '' %>>
                                    <span class="tag-chip px-6 py-3 rounded-2xl border border-white/5 bg-white/5 text-[11px] font-black text-gray-500 uppercase tracking-tighter block hover:bg-white/10">
                                        <%= cat %>
                                    </span>
                                </label>
                            <% }) %>
                        </div>
                    </div>

                    <div class="flex flex-col md:flex-row gap-4">
                        <button type="submit" class="flex-[2] bg-blue-600 hover:bg-blue-500 text-white py-6 rounded-3xl font-black uppercase text-xs tracking-[0.3em] transition-all shadow-2xl shadow-blue-600/20 active:scale-95">
                            Ayarları Sisteme İşle
                        </button>
                        <button type="button" onclick="toggleModal(true)" class="flex-1 bg-red-600/5 hover:bg-red-600 border border-red-600/20 text-red-500 hover:text-white py-6 rounded-3xl font-black uppercase text-xs tracking-[0.3em] transition-all">
                            Botu Sil
                        </button>
                    </div>
                </form>
            </div>

            <div class="lg:col-span-1 order-1 lg:order-2 space-y-8">
                <div class="p-8 rounded-[2.5rem] bg-gradient-to-br from-blue-600 to-blue-800 shadow-2xl shadow-blue-600/20 text-white relative overflow-hidden group">
                    <i class="fas fa-shield-alt absolute -bottom-4 -right-4 text-9xl opacity-10 group-hover:rotate-12 transition-transform duration-700"></i>
                    <h4 class="text-xl font-black italic uppercase mb-4 tracking-tighter">Güvenlik Notu</h4>
                    <p class="text-blue-100 text-sm leading-relaxed font-medium">
                        Bot bilgilerini güncellerken topluluk kurallarına uyduğunuzdan emin olun. Uygunsuz içerik botun kalıcı olarak kaldırılmasına neden olabilir.
                    </p>
                </div>
                
                <div class="p-8 rounded-[2.5rem] bg-[#0a0a0b] border border-white/5 space-y-6">
                    <h4 class="text-gray-400 text-[10px] font-black uppercase tracking-widest">İşlem Geçmişi</h4>
                    <div class="flex items-center gap-4">
                        <div class="w-10 h-10 rounded-xl bg-green-500/10 flex items-center justify-center text-green-500">
                            <i class="fas fa-calendar-check"></i>
                        </div>
                        <div>
                            <div class="text-[10px] text-gray-500 uppercase font-black">Eklenme Tarihi</div>
                            <div class="text-xs text-white font-bold"><%= new Date(bot.addedAt).toLocaleDateString('tr-TR') %></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>

<div id="modal" class="fixed inset-0 z-[999] hidden items-center justify-center p-6 backdrop-blur-2xl transition-all duration-500">
    <div class="absolute inset-0 bg-black/80" onclick="toggleModal(false)"></div>
    <div class="bg-[#0e0e10] border border-red-500/20 p-12 rounded-[4rem] max-w-md w-full text-center relative shadow-2xl transform scale-90 transition-transform duration-300" id="modalContent">
        <div class="w-24 h-24 bg-red-600/10 rounded-[2.5rem] flex items-center justify-center mx-auto mb-8 border border-red-600/20">
            <i class="fas fa-exclamation-triangle text-red-500 text-4xl"></i>
        </div>
        <h2 class="text-white text-3xl font-black italic uppercase mb-4 tracking-tighter text-red-500">Kalıcı Silme</h2>
        <p class="text-gray-400 text-sm leading-relaxed mb-10 px-4">
            Bu işlem geri alınamaz. Botun tüm oyları, yorumları ve veritabanı kaydı <b>tamamen temizlenecektir.</b>
        </p>
        <div class="grid grid-cols-2 gap-4">
            <button onclick="toggleModal(false)" class="bg-white/5 text-white py-5 rounded-2xl font-black text-[10px] uppercase tracking-widest">İPTAL</button>
            <form action="/bot/<%= bot.id %>/delete" method="POST">
                <button class="w-full bg-red-600 text-white py-5 rounded-2xl font-black text-[10px] uppercase tracking-widest shadow-lg shadow-red-600/20">SİLİNSİN</button>
            </form>
        </div>
    </div>
</div>

<script>
    // Karakter Sayacı Pro
    const desc = document.getElementById('desc');
    const counter = document.getElementById('counter');
    desc.addEventListener('input', () => {
        const len = desc.value.length;
        counter.textContent = `${len}/150`;
        counter.className = `text-[10px] font-black ${len > 140 ? 'text-red-500' : 'text-blue-500'}`;
    });

    // Modal Pro
    function toggleModal(show) {
        const modal = document.getElementById('modal');
        const content = document.getElementById('modalContent');
        if(show) {
            modal.classList.replace('hidden', 'flex');
            setTimeout(() => content.classList.replace('scale-90', 'scale-100'), 10);
        } else {
            content.classList.replace('scale-100', 'scale-90');
            setTimeout(() => modal.classList.replace('flex', 'hidden'), 300);
        }
    }
</script>

<%- include('partials/footer') %>