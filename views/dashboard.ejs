<%- include('partials/header') %>

<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700&family=Plus+Jakarta+Sans:wght@300;400;600;800&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<style>
    :root {
        --neon-blue: #00f2ff;
        --neon-purple: #bc13fe;
        --danger: #ff2e63;
        --success: #08f7af;
        --glass: rgba(255, 255, 255, 0.03);
    }

    body { 
        font-family: 'Plus Jakarta Sans', sans-serif; 
        background: #020204; 
        color: #a9b1d6;
        background-image: radial-gradient(circle at 50% -20%, rgba(0, 242, 255, 0.08) 0%, transparent 50%);
        overflow-x: hidden;
    }

    /* Modern Glass Card */
    .stat-card-ultra {
        background: linear-gradient(135deg, rgba(255,255,255,0.05) 0%, rgba(255,255,255,0) 100%);
        backdrop-filter: blur(20px);
        border: 1px solid rgba(255,255,255,0.1);
        transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }
    .stat-card-ultra:hover {
        transform: translateY(-5px);
        border-color: var(--neon-blue);
        box-shadow: 0 10px 40px rgba(0, 242, 255, 0.1);
    }

    /* Terminal Log Tasarımı */
    .terminal-window {
        background: rgba(0, 0, 0, 0.8);
        border: 1px solid var(--glass);
        font-family: 'JetBrains Mono', monospace;
        box-shadow: 0 15px 35px rgba(0,0,0,0.6);
        position: relative;
    }
    .terminal-header {
        background: rgba(255,255,255,0.05);
        padding: 5px 15px;
        display: flex;
        gap: 5px;
        border-bottom: 1px solid rgba(255,255,255,0.05);
    }
    .dot { width: 8px; height: 8px; border-radius: 50%; }
    .log-entry { font-size: 10px; margin-bottom: 4px; border-left: 2px solid var(--neon-blue); padding-left: 8px; animation: fadeIn 0.3s ease; }

    @keyframes fadeIn { from { opacity: 0; transform: translateX(-10px); } to { opacity: 1; transform: translateX(0); } }

    /* Custom Scrollbar */
    ::-webkit-scrollbar { width: 6px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { background: var(--glass); border-radius: 10px; }
    ::-webkit-scrollbar-thumb:hover { background: var(--neon-blue); }
</style>

<main class="container mx-auto px-6 py-10">
    
    <div class="flex flex-col xl:flex-row justify-between items-start gap-8 mb-12">
        <div class="space-y-3">
            <div class="flex items-center gap-3">
                <span class="px-3 py-1 bg-cyan-500/10 text-cyan-400 text-[10px] font-black rounded-full border border-cyan-500/20 tracking-tighter">ADMIN v5.2</span>
                <span class="w-2 h-2 bg-green-500 rounded-full animate-pulse"></span>
            </div>
            <h1 class="text-6xl font-black tracking-tighter text-white uppercase italic">
                SİGNAL<span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-purple-500">CPU</span>
            </h1>
            <p class="text-gray-500 text-[10px] font-bold uppercase tracking-[0.4em]">Sistem Veri Akışı • <%= new Date().toLocaleDateString() %></p>
        </div>

        <div class="w-full xl:w-2/5 terminal-window rounded-2xl overflow-hidden">
            <div class="terminal-header">
                <div class="dot bg-red-500"></div><div class="dot bg-yellow-500"></div><div class="dot bg-green-500"></div>
                <span class="ml-2 text-[9px] text-gray-500 font-bold uppercase tracking-widest">System_Logs.exe</span>
            </div>
            <div class="p-4 h-32 overflow-y-auto" id="logTerminal">
                <div class="log-entry text-cyan-400">[BOOT] Sistem çekirdeği aktif.</div>
                <div class="log-entry text-gray-400">[DATA] <%= allBots.length %> birim veritabanından başarıyla çekildi.</div>
                <div class="log-entry text-gray-400">[AUTH] Yönetici yetkisi doğrulandı: <%= user.username %></div>
            </div>
        </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-12">
        <div class="stat-card-ultra p-6 rounded-[2.5rem] flex flex-col items-center justify-center relative overflow-hidden">
            <div class="relative w-32 h-32">
                <canvas id="cpuRadial"></canvas>
                <div class="absolute inset-0 flex flex-col items-center justify-center">
                    <span class="text-2xl font-black text-white" id="cpuText">0%</span>
                    <span class="text-[8px] text-gray-500 uppercase font-black">Load</span>
                </div>
            </div>
            <p class="mt-4 text-[10px] font-black uppercase text-cyan-400 tracking-widest">Anlık Sunucu Yükü</p>
        </div>

        <div class="stat-card-ultra p-8 rounded-[2.5rem] group">
            <div class="flex justify-between items-start mb-4">
                <div class="bg-cyan-500/10 p-3 rounded-2xl text-cyan-400"><i class="fas fa-robot text-xl"></i></div>
                <span class="text-cyan-400 text-[10px] font-black">+<%= allBots.filter(b => (new Date() - new Date(b.createdAt)) < 86400000).length %> Bugün</span>
            </div>
            <h4 class="text-gray-500 text-[10px] font-black uppercase tracking-widest">Global Envanter</h4>
            <div class="text-5xl font-black text-white italic mt-1"><%= allBots.length %></div>
        </div>

        <div class="stat-card-ultra p-8 rounded-[2.5rem] group">
            <div class="flex justify-between items-start mb-4">
                <div class="bg-purple-500/10 p-3 rounded-2xl text-purple-400"><i class="fas fa-bolt text-xl"></i></div>
                <span class="text-purple-400 text-[10px] font-black">Live</span>
            </div>
            <h4 class="text-gray-500 text-[10px] font-black uppercase tracking-widest">Toplam Etkileşim</h4>
            <div class="text-5xl font-black text-white italic mt-1"><%= allBots.reduce((acc, bot) => acc + (bot.votes || 0), 0) %></div>
        </div>

        <div class="stat-card-ultra p-8 rounded-[2.5rem] bg-purple-600/5 border-purple-500/30">
            <div class="flex items-center gap-3 text-purple-400 mb-4">
                <i class="fas fa-hourglass-half animate-spin-slow"></i>
                <span class="text-[10px] font-black uppercase tracking-widest">İşlem Bekleyen</span>
            </div>
            <div class="text-5xl font-black text-white italic"><%= allBots.filter(b => b.status === 'pending').length %></div>
            <button class="w-full mt-6 py-3 bg-purple-600 hover:bg-purple-500 text-white text-[10px] font-black uppercase tracking-widest rounded-xl transition-all shadow-lg shadow-purple-900/20">
                Kuyruğu Denetle
            </button>
        </div>
    </div>

    <div class="stat-card-ultra rounded-[3rem] overflow-hidden shadow-2xl">
        <div class="p-10 border-b border-white/5 flex flex-col md:flex-row justify-between items-center gap-6 bg-white/[0.01]">
            <div>
                <h3 class="text-2xl font-black text-white italic tracking-tighter uppercase">Veri Merkezi</h3>
                <p class="text-[10px] text-gray-500 font-bold uppercase tracking-widest mt-1">Sistemdeki tüm bot birimleri ve metrikler</p>
            </div>
            
            <div class="relative group">
                <input type="text" id="adminSearch" placeholder="Quantum Search..." 
                       class="bg-black/50 border border-white/10 pl-12 pr-6 py-4 rounded-2xl text-xs text-white focus:border-cyan-400 outline-none w-72 transition-all">
                <i class="fas fa-search absolute left-5 top-1/2 -translate-y-1/2 text-cyan-400 opacity-50 group-focus-within:opacity-100"></i>
            </div>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left">
                <thead>
                    <tr class="text-[10px] font-black text-gray-500 uppercase tracking-[0.2em] border-b border-white/5 bg-white/[0.02]">
                        <th class="px-10 py-6">ID & Profil</th>
                        <th class="px-10 py-6">Developer ID</th>
                        <th class="px-10 py-6 text-center">Etkileşim Verisi</th>
                        <th class="px-10 py-6">Durum</th>
                        <th class="px-10 py-6 text-right">Yönetim</th>
                    </tr>
                </thead>
                <tbody id="adminTableBody" class="divide-y divide-white/[0.02]">
                    <% allBots.forEach(bot => { %>
                    <tr class="hover:bg-cyan-400/[0.02] transition-all duration-300 group">
                        <td class="px-10 py-8">
                            <div class="flex items-center gap-5">
                                <div class="relative">
                                    <img src="<%= bot.avatar %>" class="w-14 h-14 rounded-2xl object-cover ring-1 ring-white/10 group-hover:ring-cyan-400/50 transition-all shadow-xl">
                                    <div class="absolute -bottom-1 -right-1 w-4 h-4 bg-green-500 border-4 border-[#020204] rounded-full"></div>
                                </div>
                                <div>
                                    <div class="text-white font-black text-lg group-hover:text-cyan-400 transition-colors"><%= bot.name %></div>
                                    <div class="text-[9px] font-mono text-gray-600 tracking-tighter uppercase">UID: <%= bot.id %></div>
                                </div>
                            </div>
                        </td>
                        <td class="px-10 py-8">
                            <div class="flex flex-col">
                                <span class="text-white text-xs font-bold font-mono italic tracking-tighter"><%= bot.ownerID %></span>
                                <span class="text-[8px] text-gray-600 uppercase font-black mt-1 tracking-widest">Authorized Dev</span>
                            </div>
                        </td>
                        <td class="px-10 py-8 text-center">
                            <div class="flex justify-center items-center gap-6">
                                <div class="text-center">
                                    <div class="text-cyan-400 font-black text-sm tabular-nums"><%= bot.votes %></div>
                                    <div class="text-[8px] text-gray-600 uppercase font-black">Votes</div>
                                </div>
                                <div class="w-[1px] h-6 bg-white/5"></div>
                                <div class="text-center">
                                    <div class="text-white font-black text-sm tabular-nums"><%= bot.servers || 0 %></div>
                                    <div class="text-[8px] text-gray-600 uppercase font-black">Nodes</div>
                                </div>
                            </div>
                        </td>
                        <td class="px-10 py-8">
                            <span class="px-3 py-1.5 rounded-lg text-[9px] font-black uppercase tracking-tighter <%= bot.status === 'pending' ? 'bg-yellow-500/10 text-yellow-500 border border-yellow-500/20' : 'bg-green-500/10 text-green-500 border border-green-500/20' %>">
                                <%= bot.status === 'pending' ? 'Beklemede' : 'Aktif' %>
                            </span>
                        </td>
                        <td class="px-10 py-8 text-right">
                            <div class="flex justify-end gap-3 opacity-30 group-hover:opacity-100 transition-all translate-x-4 group-hover:translate-x-0">
                                <a href="/bot/<%= bot.id %>/edit" class="w-10 h-10 flex items-center justify-center bg-white/5 rounded-xl hover:bg-cyan-500 hover:text-white transition-all">
                                    <i class="fas fa-sliders-h text-xs"></i>
                                </a>
                                <form action="/bot/<%= bot.id %>/delete" method="POST" onsubmit="return confirm('KRİTİK UYARI: Bot kalıcı olarak silinecektir. Onaylıyor musunuz?')">
                                    <button class="w-10 h-10 flex items-center justify-center bg-red-500/5 text-red-500 rounded-xl hover:bg-red-500 hover:text-white transition-all">
                                        <i class="fas fa-trash-alt text-xs"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>
</main>

<script>
    // 1. CPU Radial Chart (Canlı Simülasyon)
    const cpuRadialCtx = document.getElementById('cpuRadial').getContext('2d');
    const cpuRadial = new Chart(cpuRadialCtx, {
        type: 'doughnut',
        data: {
            datasets: [{
                data: [0, 100],
                backgroundColor: ['#00f2ff', 'rgba(255,255,255,0.05)'],
                borderWidth: 0,
                circumference: 270,
                rotation: 225,
                cutout: '85%',
                borderRadius: 15
            }]
        },
        options: { 
            plugins: { legend: { display: false } }, 
            animation: { duration: 1500, easing: 'easeOutQuart' },
            responsive: true,
            maintainAspectRatio: false
        }
    });

    // Anlık Veri Güncelleme Simülasyonu
    setInterval(() => {
        const load = Math.floor(Math.random() * (40 - 10) + 10);
        cpuRadial.data.datasets[0].data = [load, 100 - load];
        cpuRadial.update();
        document.getElementById('cpuText').innerText = load + '%';
        
        // Terminale Log Düşürme (Rastgele Uyarılar)
        if(load > 35) {
            const term = document.getElementById('logTerminal');
            const entry = document.createElement('div');
            entry.className = "log-entry text-yellow-500";
            entry.innerText = `[WARN] Yüksek kaynak kullanımı: ${load}%`;
            term.prepend(entry);
            if(term.children.length > 20) term.lastChild.remove();
        }
    }, 4000);

    // 2. Quantum Search (Gerçek Zamanlı Arama)
    document.getElementById('adminSearch').addEventListener('input', function(e) {
        const val = e.target.value.toLowerCase();
        const rows = document.querySelectorAll('#adminTableBody tr');
        
        rows.forEach(row => {
            const text = row.innerText.toLowerCase();
            if(text.includes(val)) {
                row.style.display = '';
                row.style.opacity = '1';
            } else {
                row.style.display = 'none';
                row.style.opacity = '0';
            }
        });
    });

    // 3. Tablo CSV Export (Raporlama)
    function exportReport() {
        console.log("Rapor oluşturuluyor...");
        // Gelişmiş raporlama fonksiyonu buraya gelebilir
    }
</script>

<%- include('partials/footer') %>