<%- include('partials/header') %>
<style>
    .swal2-popup { border: 1px solid rgba(255,255,255,0.1); backdrop-filter: blur(15px); }
    .bot-description-box { position: relative; overflow: hidden; }
    .bot-description-box::before {
        content: '"'; position: absolute; top: -20px; left: 20px;
        font-size: 120px; color: rgba(37, 99, 235, 0.1); font-family: serif;
    }
</style>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<main class="container mx-auto px-4 lg:px-12 py-12">
    <div class="bg-[#0a0a0b]/80 border border-white/5 rounded-[3rem] overflow-hidden shadow-2xl backdrop-blur-md relative">
        
        <div class="h-80 w-full relative group overflow-hidden">
            <% if (bot.banner) { %>
                <img src="<%= bot.banner %>" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110">
            <% } else { %>
                <div class="w-full h-full bg-gradient-to-br from-blue-900/30 via-[#0a0a0b] to-blue-600/10"></div>
                <div class="absolute inset-0 bg-[url('https://www.transparenttextures.com/patterns/carbon-fibre.png')] opacity-20"></div>
            <% } %>
            <div class="absolute inset-0 bg-gradient-to-t from-[#0a0a0b] via-[#0a0a0b]/40 to-transparent"></div>
        </div>

        <div class="px-6 md:px-12 pb-12 -mt-32 relative z-10">
            <div class="flex flex-col lg:flex-row items-center lg:items-end gap-8">
                <div class="relative group">
                    <div class="absolute inset-0 bg-blue-600 blur-2xl opacity-20 group-hover:opacity-40 transition-opacity"></div>
                    <img src="<%= bot.avatar %>" 
                         class="relative w-48 h-48 rounded-[3rem] border-[10px] border-[#0a0a0b] shadow-2xl object-cover bg-black" 
                         onerror="this.src='https://cdn.discordapp.com/embed/avatars/0.png'">
                    <div class="absolute bottom-4 right-4 w-6 h-6 bg-green-500 border-4 border-[#0a0a0b] rounded-full shadow-lg"></div>
                </div>
                
                <div class="flex-1 text-center lg:text-left mb-4">
                    <div class="flex flex-wrap justify-center lg:justify-start gap-3 mb-4">
                        <% if(Array.isArray(bot.tags)) { %>
                            <% bot.tags.forEach(tag => { %>
                                <span class="bg-blue-600/10 text-blue-400 border border-blue-500/20 px-4 py-1.5 rounded-2xl text-[10px] font-black uppercase tracking-widest hover:bg-blue-600/20 transition-colors cursor-default">
                                    # <%= tag %>
                                </span>
                            <% }) %>
                        <% } %>
                    </div>
                    <h1 class="text-5xl md:text-7xl font-black text-white italic tracking-tighter uppercase leading-none mb-2">
                        <%= bot.name %>
                    </h1>
                    <p class="text-gray-500 font-bold uppercase text-xs tracking-[0.3em] flex items-center justify-center lg:justify-start gap-2">
                        <i class="fas fa-certificate text-blue-500"></i> Onaylı Bot Sürümü
                    </p>
                </div>
                
                <div class="flex flex-wrap justify-center gap-4 w-full lg:w-auto">
                    <a href="<%= bot.invite %>" target="_blank" 
                       class="flex-1 lg:flex-none flex items-center justify-center gap-3 bg-blue-600 hover:bg-blue-500 text-white px-10 py-5 rounded-2xl font-black text-xs uppercase tracking-widest shadow-[0_10px_30px_-10px_rgba(37,99,235,0.5)] transition-all active:scale-95 group">
                        <i class="fas fa-plus group-hover:rotate-90 transition-transform"></i> DAVET ET
                    </a>
                    <button onclick="voteBot('<%= bot.id %>')" 
                            class="flex-1 lg:flex-none flex items-center justify-center gap-3 bg-white/[0.03] border border-white/10 text-white px-10 py-5 rounded-2xl font-black text-xs uppercase tracking-widest hover:bg-white/[0.08] hover:border-blue-500/50 transition-all active:scale-95">
                        <i class="fas fa-chevron-up text-blue-500 text-lg"></i> 
                        <span id="vCount" class="text-xl leading-none font-black tracking-normal"><%= bot.votes %></span>
                    </button>
                </div>
            </div>
        </div>
        
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-0 border-t border-white/5 bg-black/40">
            <div class="lg:col-span-8 p-8 md:p-12 border-b lg:border-b-0 lg:border-r border-white/5">
                <div class="flex items-center gap-3 mb-8">
                    <div class="h-px flex-1 bg-gradient-to-r from-blue-600 to-transparent"></div>
                    <h3 class="text-blue-500 font-black uppercase text-[10px] tracking-[0.4em]">Proje Hakkında</h3>
                </div>
                
                <div class="bot-description-box bg-white/[0.02] border border-white/5 p-8 md:p-12 rounded-[2.5rem]">
                    <p class="text-gray-300 text-xl md:text-2xl font-medium leading-relaxed italic">
                        <%= bot.description %>
                    </p>
                </div>
            </div>
            
            <div class="lg:col-span-4 p-8 md:p-12 space-y-8 bg-black/20">
                <h3 class="text-blue-500 font-black uppercase text-[10px] tracking-[0.4em] mb-4">Metrikler</h3>
                
                <div class="grid grid-cols-1 gap-4">
                    <div class="flex items-center justify-between p-6 bg-white/[0.03] rounded-3xl border border-white/5 group hover:border-blue-500/30 transition-all">
                        <div class="flex items-center gap-4">
                            <div class="w-12 h-12 rounded-xl bg-blue-600/10 flex items-center justify-center text-blue-500 group-hover:bg-blue-600 group-hover:text-white transition-all">
                                <i class="fas fa-server"></i>
                            </div>
                            <span class="text-gray-500 font-bold text-xs uppercase tracking-widest">Sunucular</span>
                        </div>
                        <span class="text-white font-black text-2xl tracking-tighter"><%= (bot.servers || 0).toLocaleString() %></span>
                    </div>

                    <div class="flex items-center justify-between p-6 bg-white/[0.03] rounded-3xl border border-white/5 group hover:border-blue-500/30 transition-all">
                        <div class="flex items-center gap-4">
                            <div class="w-12 h-12 rounded-xl bg-purple-600/10 flex items-center justify-center text-purple-500 group-hover:bg-purple-600 group-hover:text-white transition-all">
                                <i class="fas fa-terminal"></i>
                            </div>
                            <span class="text-gray-500 font-bold text-xs uppercase tracking-widest">Komutlar</span>
                        </div>
                        <span class="text-white font-black text-2xl tracking-tighter"><%= bot.commands || 0 %>+</span>
                    </div>

                    <div class="flex items-center justify-between p-6 bg-white/[0.03] rounded-3xl border border-white/5 group hover:border-blue-500/30 transition-all">
                        <div class="flex items-center gap-4">
                            <div class="w-12 h-12 rounded-xl bg-green-600/10 flex items-center justify-center text-green-500 group-hover:bg-green-600 group-hover:text-white transition-all">
                                <i class="fas fa-code"></i>
                            </div>
                            <span class="text-gray-500 font-bold text-xs uppercase tracking-widest">Prefix</span>
                        </div>
                        <span class="bg-blue-600/20 text-blue-400 px-4 py-2 rounded-xl font-black text-sm border border-blue-500/30 group-hover:bg-blue-600 group-hover:text-white transition-all">
                            <%= bot.prefix %>
                        </span>
                    </div>
                </div>

                <button onclick="copyURL()" class="w-full py-4 rounded-2xl bg-white/5 border border-white/10 text-gray-400 font-bold text-[10px] uppercase tracking-widest hover:text-white hover:bg-white/10 transition">
                    <i class="fas fa-share-alt mr-2"></i> Profili Paylaş
                </button>
            </div>
        </div>
    </div>
</main>

<script>
// Paylaşma fonksiyonu
function copyURL() {
    navigator.clipboard.writeText(window.location.href);
    Swal.fire({
        toast: true,
        position: 'top-end',
        icon: 'success',
        title: 'Link kopyalandı!',
        showConfirmButton: false,
        timer: 3000,
        background: '#0a0a0b',
        color: '#fff'
    });
}

// Oy verme fonksiyonu (Geliştirilmiş)
async function voteBot(id) {
    // Buton animasyonu başlatılabilir (Loading state)
    try {
        const res = await fetch('/vote/' + id, { method: 'POST' });
        const data = await res.json();
        
        const swalConfig = {
            background: '#0a0a0b',
            color: '#fff',
            confirmButtonColor: '#2563eb',
            customClass: { popup: 'rounded-[2rem]' }
        };

        if (data.status === "success") {
            document.getElementById('vCount').innerText = data.votes;
            Swal.fire({ ...swalConfig, icon: 'success', title: 'Harika!', text: data.message });
        } else {
            Swal.fire({ ...swalConfig, icon: 'warning', title: 'Hop!', text: data.message });
        }
    } catch (e) { 
        Swal.fire({ icon: 'error', title: 'Hata', text: 'Bir şeyler ters gitti!', background: '#0a0a0b', color: '#fff' }); 
    }
}
</script>

<%- include('partials/footer') %>